# PySRMKit Environment Configuration Example

# PostgreSQL connection string for the persistent runtime, Alembic migrations, and FastAPI host
PYSRMKIT_DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/pysrmkit

# Dedicated PostgreSQL database URL used exclusively for repository contract tests in CI and locally
PYSRMKIT_POSTGRESQL_TEST_URL=postgresql+psycopg://postgres@localhost:5432/pysrmkit_test

# URL of the PySRMKit FastAPI host (consumed by external applications such as Next.js dashboard)
PYSRMKIT_API_URL=http://127.0.0.1:8000
